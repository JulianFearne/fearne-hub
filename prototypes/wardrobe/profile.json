  "rules": {
    "max_statement": 1,
    "max_colour_pieces": 2,
    "max_patterns": 1,
    "colour_at_face_bonus": true,
    "contrast_bonus_min": 28,
    "notes": [
      "Slim-straight, never skin-tight, never loose.",
      "Buy for the shoulder, alter the waist, sleeves and hems.",
      "Patterns small in scale, cool in ground.",
      "Cool tones near the face, warm tones (if any) below the waist."
    ]
